{
  "name": "@paperbox/root",
  "private": true,
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "jest --runInBand --no-coverage",
    "test:watch": "jest --watch",
    "test:e2e": "jest apps/server/test --runInBand --no-coverage",
    "lint": "eslint apps/server/src apps/web/src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p apps/server/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
